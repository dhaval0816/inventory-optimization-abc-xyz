/// Disconnected what-if parameter. Annual holding cost as a share of unit cost. Drives EOQ only.
table 'Holding Cost %'
	lineageTag: 28126257-8130-4de7-ab14-07c74153a816

	measure 'Holding Cost % Value' = SELECTEDVALUE('Holding Cost %'[Holding Cost %], 0.25)
		formatString: 0%
		lineageTag: d58b0dbe-4bcc-482a-8034-dd0e65792232

	column 'Holding Cost %'
		dataType: double
		formatString: 0%
		lineageTag: 1811b131-0eb6-4b5b-be15-3fd31cb3ed45
		summarizeBy: none
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition 'Holding Cost %' = calculated
		mode: import
		source = GENERATESERIES(0.15, 0.35, 0.05)

	annotation PBI_ResultType = Table

