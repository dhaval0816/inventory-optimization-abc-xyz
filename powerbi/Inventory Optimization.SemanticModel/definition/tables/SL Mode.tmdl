/// Disconnected toggle. Class-based reproduces the Excel policy (A 98 / B 95 / C 90); Uniform hands
/// control to the service level slider.
table 'SL Mode'
	lineageTag: ad3c0a2d-d5a5-47ea-b868-62b188f70bf3

	column 'SL Mode'
		dataType: string
		lineageTag: 058a1d44-d41f-48e7-af03-68145f2c5e3d
		summarizeBy: none
		sourceColumn: [SL Mode]
		sortByColumn: SortOrder

		annotation SummarizationSetBy = Automatic

	column SortOrder
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: db8f2b8c-2e32-4067-829f-b446fbae9df8
		summarizeBy: none
		sourceColumn: [SortOrder]

		annotation SummarizationSetBy = Automatic

	partition 'SL Mode' = calculated
		mode: import
		source =
				DATATABLE("SL Mode", STRING, "SortOrder", INTEGER,
				    { { "Class-based (A 98% / B 95% / C 90%)", 1 }, { "Uniform (slider)", 2 } })

	annotation PBI_ResultType = Table

