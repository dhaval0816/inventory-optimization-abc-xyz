/// Nine points for the service-level curve, derived FROM the what-if parameter column rather than
/// typed as literals. 'Service Level' is GENERATESERIES(0.8, 0.995, 0.005), a double: a hand-typed
/// 0.97 does not equal 0.8 + 0.005*34 in binary floating point, so TREATAS would match nothing and
/// the curve chart would render empty.
table 'Service Level Curve'
	lineageTag: 5cf2a192-7866-46b6-8287-34fea27c4593

	column Level
		dataType: double
		formatString: 0.0%
		lineageTag: b8971bdd-61c1-4166-a3d7-f4b0af55f93d
		summarizeBy: none
		sourceColumn: [Level]

		annotation SummarizationSetBy = Automatic

	partition 'Service Level Curve' = calculated
		mode: import
		source =
				VAR Keep = { 0.80, 0.85, 0.90, 0.92, 0.95, 0.97, 0.98, 0.99, 0.995 }
				RETURN
				    SELECTCOLUMNS (
				        FILTER ( 'Service Level', ROUND ( 'Service Level'[Service Level], 3 ) IN Keep ),
				        "Level", 'Service Level'[Service Level]
				    )

	annotation PBI_ResultType = Table

