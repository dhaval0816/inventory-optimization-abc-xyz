expression Sales_2009_2010 =
		let
		    Source   = Excel.Workbook(File.Contents(SourceFile), null, true),
		    Sheet    = Source{[Item = "Year 2009-2010", Kind = "Sheet"]}[Data],
		    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars = true]),
		    Typed    = Table.TransformColumnTypes(Promoted, {
		                   {"Invoice", type text}, {"StockCode", type text}, {"Description", type text},
		                   {"Quantity", Int64.Type}, {"InvoiceDate", type datetime}, {"Price", type number},
		                   {"Customer ID", Int64.Type}, {"Country", type text}}),
		    NoOverlap = Table.SelectRows(Typed, each [InvoiceDate] < #datetime(2010, 12, 1, 0, 0, 0))
		in
		    NoOverlap
	lineageTag: 0e6418ec-e422-4274-ab0d-2b81fc3e2916

