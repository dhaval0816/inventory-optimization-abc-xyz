expression Excel_SKU_Policy =
		let
		    Source   = Excel.Workbook(File.Contents(ExcelModelFile), null, true),
		    Sheet    = Source{[Item = "SKU_Policy", Kind = "Sheet"]}[Data],
		    Skipped  = Table.Skip(Sheet, 3),
		    Promoted = Table.PromoteHeaders(Skipped, [PromoteAllScalars = true]),
		    Kept     = Table.SelectColumns(Promoted, {"SKU", "ABC Class", "XYZ Class", "On Hand (simulated)",
		                                              "Safety Stock (units)", "Reorder Point (units)",
		                                              "EOQ (units)", "Target Service Level"}),
		    NoBlank  = Table.SelectRows(Kept, each [SKU] <> null and [SKU] <> ""),
		    Renamed  = Table.RenameColumns(NoBlank, {
		                   {"SKU", "StockCode"}, {"ABC Class", "ABC_Excel"}, {"XYZ Class", "XYZ_Excel"},
		                   {"On Hand (simulated)", "OnHand_Excel"}, {"Safety Stock (units)", "SS_Excel"},
		                   {"Reorder Point (units)", "ROP_Excel"}, {"EOQ (units)", "EOQ_Excel"},
		                   {"Target Service Level", "SL_Excel"}}),
		    Typed    = Table.TransformColumnTypes(Renamed, {
		                   {"StockCode", type text}, {"ABC_Excel", type text}, {"XYZ_Excel", type text},
		                   {"OnHand_Excel", Int64.Type}, {"SS_Excel", Int64.Type}, {"ROP_Excel", Int64.Type},
		                   {"EOQ_Excel", Int64.Type}, {"SL_Excel", type number}})
		in
		    Typed
