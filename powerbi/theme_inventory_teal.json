{
  "name": "Inventory Optimization - Teal & Amber",
  "dataColors": [
    "#008C82",
    "#C47F15",
    "#3B6FD4",
    "#C43E7A",
    "#55882C",
    "#8A3FA8",
    "#C0392B",
    "#0090B5"
  ],
  "good": "#1E7A4C",
  "neutral": "#C47F15",
  "bad": "#B3261E",
  "maximum": "#00504C",
  "center": "#A9BDB9",
  "minimum": "#E6F0EE",
  "null": "#C9D4D1",
  "hyperlink": "#0B5E59",
  "visitedHyperlink": "#6E7C79",
  "foreground": "#1A2421",
  "foregroundNeutralSecondary": "#3E4B48",
  "foregroundNeutralTertiary": "#6E7C79",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F7F6",
  "backgroundNeutral": "#E4EDEA",
  "tableAccent": "#008C82",
  "secondaryBackground": "#E4EDEA",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1A2421"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1A2421"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#3E4B48"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 20,
      "color": "#0B5E59"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F4F7F6" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#E4EDEA" } },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#DCE5E2" } },
            "radius": 8
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "background": { "solid": { "color": "#FFFFFF" } },
            "foreground": { "solid": { "color": "#6E7C79" } },
            "transparency": 0,
            "border": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "title": [
          {
            "alignment": "left",
            "fontColor": { "solid": { "color": "#1A2421" } }
          }
        ]
      },
      "categoryAxis": [
        {
          "showAxisTitle": false,
          "labelColor": { "solid": { "color": "#6E7C79" } },
          "fontSize": 9,
          "gridlineShow": false,
          "lineColor": { "solid": { "color": "#DCE5E2" } }
        }
      ],
      "valueAxis": [
        {
          "showAxisTitle": false,
          "labelColor": { "solid": { "color": "#6E7C79" } },
          "fontSize": 9,
          "gridlineShow": true,
          "gridlineColor": { "solid": { "color": "#EDF2F0" } },
          "gridlineThickness": 1,
          "gridlineStyle": "solid"
        }
      ],
      "legend": [
        {
          "show": true,
          "position": "Top",
          "showTitle": false,
          "labelColor": { "solid": { "color": "#3E4B48" } },
          "fontSize": 9
        }
      ],
      "labels": [
        {
          "color": { "solid": { "color": "#1A2421" } },
          "fontSize": 9
        }
      ]
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "lineStyle": "solid",
            "showMarker": false
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [
          {
            "barRoundedCorners": 4
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "dataPoint": [
          {
            "barRoundedCorners": 4
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "slices": [
          {
            "innerRadiusRatio": 65
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": { "solid": { "color": "#3E4B48" } },
            "fontSize": 9
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#1A2421" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#EDF2F0" } },
            "rowPadding": 4,
            "outlineColor": { "solid": { "color": "#DCE5E2" } }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#06403D" } },
            "fontSize": 9,
            "bold": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#1A2421" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#1A2421" } },
            "backColorSecondary": { "solid": { "color": "#F7FAF9" } },
            "fontSize": 9
          }
        ]
      }
    }
  }
}
